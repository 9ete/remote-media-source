<?xml version="1.0"?>
<ruleset name="RemoteMediaSource">
  <description>WordPress PHPCS Standards.</description>

  <file>./</file>

  <!--
    Patterns match the file's ABSOLUTE path case-insensitively, so repo-dir
    anchored prefixes (remote-media-source/...) are used for directories whose
    names can collide with parent-path segments (e.g. a working copy living
    under a "Brain/" folder would match a bare "*/brain/*" and exclude the
    entire repo from the scan).
  -->
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/.git/*</exclude-pattern>
  <exclude-pattern>*/zips/*</exclude-pattern>
  <exclude-pattern>*/.claude/*</exclude-pattern>
  <exclude-pattern>*/tests/*</exclude-pattern>
  <exclude-pattern>*/test-envs/*</exclude-pattern>
  <exclude-pattern>*/remote-media-source/docs/*</exclude-pattern>
  <exclude-pattern>*/remote-media-source/brain/*</exclude-pattern>
  <exclude-pattern>*/remote-media-source/remote-media-source/*</exclude-pattern>
  <exclude-pattern>*/.plugin-check-dist/*</exclude-pattern>

  <rule ref="WordPress">
    <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
    <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
  </rule>
  <rule ref="WordPress-Extra">
    <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
    <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
  </rule>
  <rule ref="WordPress-Docs" />

  <config name="testVersion" value="8.1-8.4"/>
  <rule ref="PHPCompatibilityWP" />

  <config name="minimum_supported_wp_version" value="6.0"/>
  <arg name="basepath" value="."/>
  <arg name="colors"/>
  <arg name="extensions" value="php"/>
</ruleset>
